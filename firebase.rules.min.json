{
  "rules": {
    "likes": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000"
      }
    },
    "song_gender": {
      ".read": true,
      "$uuid": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 2"
      }
    },
    "queue_index": {
      ".read": true,
      ".indexOn": [
        "owner",
        "created"
      ],
      "$qid": {
        ".write": "(!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && data.child('owner').val() === auth.uid) || (auth != null && root.child('queues/' + $qid + '/meta/open').val() === true && newData.child('owner').val() === data.child('owner').val())",
        ".validate": "!newData.exists() || newData.hasChildren(['owner','title'])",
        "owner": {
          ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || data.val() === newData.val())"
        },
        "ownerName": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "created": {
          ".validate": "newData.isNumber()"
        },
        "open": {
          ".validate": "newData.isBoolean()"
        },
        "listed": {
          ".validate": "newData.isBoolean()"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "queues": {
      ".read": "auth != null && query.orderByChild === 'meta/owner' && query.equalTo === auth.uid",
      ".indexOn": [
        "meta/owner"
      ],
      "$qid": {
        ".read": true,
        ".write": "!data.exists() ? newData.child('meta/owner').val() === auth.uid : data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".write": "(!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && data.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['owner'])",
          "owner": {
            ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || data.val() === newData.val())"
          },
          "ownerName": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "open": {
            ".validate": "newData.isBoolean()"
          },
          "listed": {
            ".validate": "newData.isBoolean()"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "tracks": {
          ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid",
          "$key": {
            ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid || (auth != null && root.child('queues/' + $qid + '/meta/open').val() === true && !data.exists() && newData.child('by').val() === auth.uid)",
            ".validate": "newData.hasChildren(['src','id','ord'])",
            "src": {
              ".validate": "newData.isString() && (newData.val() === 'suno' || newData.val() === 'yt' || newData.val() === 'ytpl' || newData.val() === 'sp' || newData.val() === 'spl')"
            },
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 140"
            },
            "sub": {
              ".validate": "newData.isString() && newData.val().length <= 90"
            },
            "art": {
              ".validate": "newData.isString() && newData.val().length <= 200 && (newData.val() === '' || newData.val().beginsWith('https://'))"
            },
            "dur": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
            },
            "ord": {
              ".validate": "newData.isNumber()"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "byName": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "chat": {
          ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid",
          "$key": {
            ".write": "auth != null && (!data.exists() ? newData.child('u').val() === auth.uid : root.child('queues/' + $qid + '/meta/owner').val() === auth.uid)",
            ".validate": "newData.hasChildren(['u','t','a'])",
            "u": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 600"
            },
            "a": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "play": {
          ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid",
          ".validate": "newData.hasChildren(['at'])",
          "now": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "next": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            }
          },
          "heard": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "head": {
          ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid",
          ".validate": "!newData.exists() || newData.hasChildren(['k','t','at'])",
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 36000"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "playing": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "likes": {
          "$track": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean() && newData.val() === true && $track.length <= 60"
            }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren()",
            "$conn": {
              ".validate": "newData.isNumber() && root.child('queues/' + $qid + '/meta').exists()"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$rest": {
      ".read": false,
      ".write": false
    }
  }
}
