// Sound Lexicon - Realtime Database security rules.
//
// TO DEPLOY: Firebase console > Realtime Database > Rules > paste this whole file > Publish.
// ALSO REQUIRED for shared queues: Authentication > Sign-in method > Anonymous > Enable.
// Nothing else on the site uses auth; the library's hearts stay anonymous and open.
//
// Comments are allowed here - firebase-tools ships database.rules.json with them - but the
// ONLY key permitted at the top level is "rules", and inside the tree every key must be
// either a .directive or a child name mapping to an object. There is nowhere to put a
// string note, so the reasoning lives in comments like this one. An earlier version of this
// file carried "_comment" and "_note" strings; those would have been refused on paste.
{
  "rules": {

    // The library's shared heart counts. World readable and writable, no auth, exactly as
    // before this file existed: a number that only ever moves by one.
    "likes": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000"
      }
    },

    // The vocal-gender overlay, set from the library's own editor. Unchanged.
    "song_gender": {
      ".read": true,
      "$uuid": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 2"
      }
    },

    // One small public card per queue: title, author, date, track count. The browse page
    // reads this instead of the queues themselves, so listing a hundred queues costs a
    // hundred short records rather than a hundred full track lists - and "queues" below
    // never has to become enumerable at all.
    //
    // listed=false keeps a queue off the browse page. The row still exists here, because the
    // owner's own list is built from the same place; the page filters on it. So unlisted
    // means unadvertised, not private, which is what the page says.
    "queue_index": {
      ".read": true,
      ".indexOn": ["owner", "created"],
      "$qid": {
        ".write": "(!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && data.child('owner').val() === auth.uid) || (auth != null && root.child('queues/' + $qid + '/meta/open').val() === true && newData.child('owner').val() === data.child('owner').val())",
        ".validate": "!newData.exists() || newData.hasChildren(['owner','title'])",
        "owner":     { ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || data.val() === newData.val())" },
        "ownerName": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "title":     { ".validate": "newData.isString() && newData.val().length <= 60" },
        "created":   { ".validate": "newData.isNumber()" },
        "open":      { ".validate": "newData.isBoolean()" },
        "listed":    { ".validate": "newData.isBoolean()" },
        "n":         { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
        "$other":    { ".validate": false }
      }
    },

    // The queues themselves.
    //
    // The read here is deliberately NOT true. Granting it would let anyone pull every queue
    // on the site in one request. It is allowed only for the single query shape that asks
    // for your own queues and nothing else, so listing yours works and listing everyone's is
    // refused. Reading ONE queue is allowed a level down, where its id is the secret.
    "queues": {
      ".read": "auth != null && query.orderByChild === 'meta/owner' && query.equalTo === auth.uid",
      ".indexOn": ["meta/owner"],
      "$qid": {
        ".read": true,

        // This rule is what lets a queue be CREATED and DELETED at all, and it is easy to
        // leave out. Permission comes from a .write at or above the path being written, and
        // a child's rule never authorises a write to its parent -- so the meta and tracks
        // rules below, however correct, do not permit set() or remove() on the queue node
        // itself, which is exactly what publishing and deleting do. Verified by probe: the
        // whole-node write answered 401 while the same data written to meta and tracks/<key>
        // answered 200.
        //
        // Create: the meta/owner being written must be you. After that: only the existing
        // owner. Guests are unaffected -- their track writes are granted further down, and a
        // deny here does not revoke a grant below it.
        ".write": "!data.exists() ? newData.child('meta/owner').val() === auth.uid : data.child('meta/owner').val() === auth.uid",

        // Written once by whoever creates the queue, and thereafter only by that uid. owner
        // can never be reassigned, so ownership cannot be taken by a later write.
        "meta": {
          ".write": "(!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && data.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['owner'])",
          "owner":     { ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || data.val() === newData.val())" },
          "ownerName": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "title":     { ".validate": "newData.isString() && newData.val().length <= 60" },
          "open":      { ".validate": "newData.isBoolean()" },
          "listed":    { ".validate": "newData.isBoolean()" },
          "created":   { ".validate": "newData.isNumber()" },
          "v":         { ".validate": "newData.isNumber()" },
          "$other":    { ".validate": false }
        },

        // The owner may always write. Anyone signed in may write only while meta/open is
        // true, and then only to ADD: the per-key rule requires the row not to exist yet and
        // to carry the writer's own uid. That is what makes "open adding" mean adding, and
        // not also reordering or deleting.
        "tracks": {
          ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid",
          "$key": {
            ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid || (auth != null && root.child('queues/' + $qid + '/meta/open').val() === true && !data.exists() && newData.child('by').val() === auth.uid)",
            ".validate": "newData.hasChildren(['src','id','ord'])",
            "src":    { ".validate": "newData.isString() && (newData.val() === 'suno' || newData.val() === 'yt' || newData.val() === 'ytpl' || newData.val() === 'sp' || newData.val() === 'spl')" },
            "id":     { ".validate": "newData.isString() && newData.val().length <= 40" },
            "title":  { ".validate": "newData.isString() && newData.val().length <= 140" },
            "sub":    { ".validate": "newData.isString() && newData.val().length <= 90" },
            // Spotify rows only. Every other source names its cover after the id, so the
            // address is worked out at the other end rather than stored; Spotify's is a hash
            // and a guest who has never resolved the track cannot reach it any other way.
            // https only, because it is read straight into an img src.
            "art":    { ".validate": "newData.isString() && newData.val().length <= 200 && (newData.val() === '' || newData.val().beginsWith('https://'))" },
            "dur":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600" },
            "ord":    { ".validate": "newData.isNumber()" },
            "by":     { ".validate": "newData.isString() && newData.val().length <= 128" },
            "byName": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "$other": { ".validate": false }
          }
        },

        // Open to any signed-in visitor, because chat is how a guest suggests a track when
        // the queue is locked. A message may only be created under its author's own uid, and
        // only the owner may delete one - so nobody can edit or erase somebody else's words.
        "chat": {
          ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid",
          "$key": {
            ".write": "auth != null && (!data.exists() ? newData.child('u').val() === auth.uid : root.child('queues/' + $qid + '/meta/owner').val() === auth.uid)",
            ".validate": "newData.hasChildren(['u','t','a'])",
            "u":      { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "n":      { ".validate": "newData.isString() && newData.val().length <= 24" },
            "t":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 600" },
            "a":      { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        // Where the queue is: the track playing, the up-next order and the played list, as
        // track keys ("suno:<uuid>", "yt:<id>"). The owner's player writes it and everyone's
        // columns read it, so every visitor sees the same queue; a visitor's own picks never
        // touch it. Owner only - a visitor cannot move the queue by writing here by hand.
        "play": {
          ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid",
          ".validate": "newData.hasChildren(['at'])",
          "now":   { ".validate": "newData.isString() && newData.val().length <= 60" },
          "at":    { ".validate": "newData.isNumber()" },
          "next":  { "$i": { ".validate": "newData.isString() && newData.val().length <= 60" } },
          "heard": { "$i": { ".validate": "newData.isString() && newData.val().length <= 60" } },
          "$other": { ".validate": false }
        },

        // The owner's PLAYHEAD, so a visitor's player can sit at the same second rather than
        // merely on the same track. `t` is where the track was at server time `at`, and
        // `playing` says whether it has been running since. A visitor works out the position
        // for themselves from those three, which is why this is written on events - start,
        // pause, seek, track change - and once every several seconds in between, rather than
        // on a tick. Owner only: a visitor mirroring a playhead must never be able to move it.
        //
        // Separate from "play" on purpose. That node is the columns, and every write of it
        // re-renders three lists on every visitor; a playhead changes far more often and has
        // nothing to say about the lists.
        "head": {
          ".write": "root.child('queues/' + $qid + '/meta/owner').val() === auth.uid",
          ".validate": "!newData.exists() || newData.hasChildren(['k','t','at'])",
          "k":       { ".validate": "newData.isString() && newData.val().length <= 60" },
          "t":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 36000" },
          "at":      { ".validate": "newData.isNumber()" },
          "playing": { ".validate": "newData.isBoolean()" },
          "$other":  { ".validate": false }
        },

        // The listeners' hearts: likes/<track key>/<uid> = true. Anyone signed in may add or
        // take back their own like, and only their own; the count is how many uids sit under
        // a track. Removing is a delete, which .validate never blocks.
        "likes": {
          "$track": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean() && newData.val() === true && $track.length <= 60"
            }
          }
        },

        // Who has this queue open right now: one row per open tab, at presence/<uid>/<conn>,
        // holding the server time it arrived. A visitor may write only under their own uid,
        // and the database removes the row itself when that tab's connection drops
        // (onDisconnect), so the count never needs a cleanup pass. Reads come from the
        // queue-level .read above. Only a queue that still exists can gain rows - a tab
        // reconnecting to a deleted queue must not resurrect its node. (.validate is skipped
        // on deletes, so removing a row is never blocked by that check.)
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren()",
            "$conn": {
              ".validate": "newData.isNumber() && root.child('queues/' + $qid + '/meta').exists()"
            }
          }
        },

        "$other": { ".validate": false }
      }
    },

    // Anything not named above is closed. Without this a typo in a path would quietly
    // become a new world-writable bucket.
    "$rest": {
      ".read": false,
      ".write": false
    }
  }
}
